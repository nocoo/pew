#!/usr/bin/env sh

# pre-push: G2 Security (dependency CVEs + secret scan).
#
# L2 API E2E, L3 browser E2E and the unit/coverage suite deliberately do NOT
# run here. Each takes minutes and each has hung past its own summary at least
# once, which left a push waiting on a process that would never exit. CI runs
# them as the enforcement gate (api-e2e, browser-e2e, quality jobs); run them
# locally on demand with `bun run verify`.
#
# G2 stays: it is fast (seconds), it fails closed when a scanner is missing,
# and it is the one check that must not wait for CI — a leaked credential is
# already public by the time CI reports it.

set -e

bun --no-env-file -e 'import { assertNoLocalEnv } from "./scripts/e2e-utils.ts"; assertNoLocalEnv();'

G2_OUT=$(mktemp)
trap 'rm -f "$G2_OUT"' EXIT

G2_EXIT=0
bun run test:security > "$G2_OUT" 2>&1 || G2_EXIT=$?

echo "─── G2 Security ───"
cat "$G2_OUT"

if [ "$G2_EXIT" -ne 0 ]; then
  echo "❌ pre-push FAILED: G2 security gate."
  exit 1
fi

echo "✅ pre-push passed: G2 security (osv-scanner + gitleaks)"
