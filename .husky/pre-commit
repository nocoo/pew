#!/usr/bin/env sh
# pre-commit: L1 + G1 quality gate against the Git index snapshot.
#
# Materialises the staged tree into a temp snapshot (checkout-index),
# regenerates staged prerequisites inside it, reuses worktree
# dependencies read-only, and runs the sequential gate there:
#   L1  vitest run --coverage (95% x4 floors, exit-enforced)
#   G1a scripts/parallel-typecheck.sh (5 packages, strict tsc)
#   G1b biome check --error-on-warnings
#   G1c AST gates: dynamic-delete + @ts-expect-error
# No result caches, no extension fast paths: every commit runs the full
# gate, so a staged bug fails even when the worktree holds an unstaged
# fix. The worktree and index are never mutated; all generated output
# stays inside the snapshot and is removed on every exit path.

set -e

command -v git >/dev/null 2>&1 || { echo "pre-commit: git is required" >&2; exit 1; }
command -v bun >/dev/null 2>&1 || { echo "pre-commit: bun is required" >&2; exit 1; }

snapshot=
cleanup() {
  status=$?
  trap - EXIT INT TERM HUP
  if [ -n "$snapshot" ]; then
    rm -rf "$snapshot" || :
    snapshot=
  fi
  exit "$status"
}
trap cleanup EXIT
trap "exit 130" INT
trap "exit 143" TERM
trap "exit 129" HUP

repo=$(git rev-parse --show-toplevel)
snapshot=$(mktemp -d "${TMPDIR:-/tmp}/pew-index-XXXXXX")
git checkout-index --all --prefix="$snapshot/"

# Staged manifests must match the installed worktree copies: node_modules
# is reused read-only below, so a staged manifest that diverges from the
# worktree would check a dependency set that was never installed.
for f in package.json bun.lock; do
  if [ ! -f "$snapshot/$f" ]; then
    echo "pre-commit: staged $f is required" >&2
    exit 1
  fi
  if ! cmp -s "$snapshot/$f" "$repo/$f"; then
    echo "pre-commit: staged $f differs from the worktree copy — run the install you need, then 'git add $f' before committing" >&2
    exit 1
  fi
done
for m in "$snapshot"/packages/*/package.json; do
  [ -f "$m" ] || continue
  if ! cmp -s "$m" "$repo/packages/${m##*/packages/}"; then
    echo "pre-commit: staged packages/${m##*/packages/} differs from the worktree copy — stage the installed state before committing" >&2
    exit 1
  fi
done

# Lockfile consistency, check-only and bounded: verifies the staged
# manifests against the staged bun.lock. --ignore-scripts keeps dry-run
# free of lifecycle execution; --frozen-lockfile fails fast on drift.
if ! (cd "$snapshot" && bun install --frozen-lockfile --dry-run --ignore-scripts >/dev/null 2>&1); then
  echo "pre-commit: staged package.json/bun.lock are out of sync — run 'bun install' and commit the updated bun.lock" >&2
  exit 1
fi
rm -rf "$snapshot/node_modules"

sh "$snapshot/scripts/snapshot-node-modules.sh" "$repo" "$snapshot"
mkdir -p "$snapshot/node_modules/.cache"

# Checks read staged configs via `bun run` with cwd=snapshot. Strip Git's
# hook environment so nested git usage cannot touch the real index/worktree.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX
unset GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
export XDG_CACHE_HOME="$snapshot/node_modules/.cache/xdg"
export XDG_STATE_HOME="$snapshot/node_modules/.cache/xdg"
PATH="$snapshot/node_modules/.bin:$PATH"
cd "$snapshot"

# Staged prerequisites, generated inside the snapshot before any reader:
# tsc of dependents resolves @pew/core via the workspace link to
# packages/core/dist, and packages/web/next-env.d.ts imports .next/types
# route declarations. Both derive from staged sources, never the worktree.
bun run --cwd packages/core build
if [ ! -d node_modules/next ] && [ ! -d packages/web/node_modules/next ]; then
  echo "pre-commit: next is not installed — run 'bun install' and commit the result" >&2
  exit 1
fi
(cd packages/web && bunx next typegen)

bun run test:coverage
bash scripts/parallel-typecheck.sh
biome check --no-errors-on-unmatched --error-on-warnings --max-diagnostics=500 .
bun run gate:dynamic-delete
bun run gate:ts-expect-error

echo "✅ pre-commit passed: L1 coverage ≥95% (statements/branches/functions/lines) + G1 strict statics on the index snapshot"
